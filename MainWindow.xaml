<Window x:Class="FaceitACToggle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localToggle="clr-namespace:ToggleClass"
        Title="Faceit AC Toggle"
        Height="320" Width="300"
        Background="#111">

    <Grid Margin="10">

        <!-- Toggle Switch -->
        <localToggle:Toggle x:Name="ToggleAC"
                            Width="60"
                            Height="30"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,20,0,0"
                            Click="ToggleAC_Click" Checked="ToggleAC_Checked"/>

        <!-- Log Box -->
        <TextBox x:Name="LogBox"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Bottom"
                 Height="220"
                 Background="#111"
                 Foreground="White"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>
    </Grid>
</Window>